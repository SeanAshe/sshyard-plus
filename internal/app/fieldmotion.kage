package main

// Where each dot of the welcome field sits and how lit it is: one pixel
// a dot, its offset from its cell's middle in red and green (0.5 for
// none, Reach DIPs at either end) and its light in blue. The dots drift
// on a slow current (Time), the pointer's path (Trail) warms and parts
// them, and the clicks' rings (Rings) run through them.

var Time float
var Spacing float
var Origin vec2
var Reach float

// Trail holds the pointer's marks: where (xy), how warm (z) and how far
// the warmth reaches (w), in DIPs of the pane.
var TrailCount int
var Trail [25]vec4

// Rings holds the clicks: where (xy), seconds since (z) and strength (w).
var RingCount int
var Rings [4]vec4

const (
	tau       = 6.2831853
	ringSpeed = 460.0
	ringLife  = 1.8
)

func hash(p vec2) float {
	q := fract(vec3(p.x, p.y, p.x) * 0.1031)
	q += dot(q, q.yzx+33.33)
	return fract((q.x + q.y) * q.z)
}

func noise(p vec2) float {
	i := floor(p)
	f := fract(p)
	u := f * f * (3 - 2*f)
	a := hash(i)
	b := hash(i + vec2(1, 0))
	c := hash(i + vec2(0, 1))
	d := hash(i + vec2(1, 1))
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y)
}

func Fragment(dst vec4, pos vec2) vec4 {
	cell := floor(dst.xy)
	home := Origin + (cell+0.5)*Spacing
	seed := hash(cell + 71)

	// The current turns slowly across the pane, and each dot bobs on it
	// at a pace of its own.
	turn := noise(home/260+Time*vec2(0.04, 0.025)) * 2 * tau
	bob := Time * (0.35 + 0.3*seed)
	off := vec2(cos(turn), sin(turn))*Reach*0.35 + vec2(sin(bob+seed*tau), cos(bob*0.8+seed*9))*Reach*0.15

	heat := 0.0
	push := vec2(0)
	for i := 0; i < TrailCount; i++ {
		m := Trail[i]
		away := home - m.xy
		k := m.z * exp(-dot(away, away)/(m.w*m.w))
		heat += k
		push += away / (length(away) + 1) * k
	}
	for i := 0; i < RingCount; i++ {
		r := Rings[i]
		away := home - r.xy
		d := length(away)
		front := (d - r.z*ringSpeed) / (14 + 36*r.z)
		fade := 1 - r.z/ringLife
		k := r.w * fade * fade * exp(-front*front)
		heat += k
		push += away / (d + 1) * k * 1.5
	}

	off += push * Reach
	l := length(off)
	if l > Reach {
		off *= Reach / l
	}
	return vec4(off/Reach*0.5+0.5, min(heat, 1), 1)
}
