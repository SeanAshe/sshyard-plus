{
  "name": "SSHYard",
  "identifier": "com.sshyard.desktop",
  "version": "1.8.0",
  "icon": "resources/icon.png",
  "out": "build",
  "i18n": { "dir": "locales", "source": "en" },
  "updates": {
    "publicKey": "Qx0BBs2S17rvWLydEI0f9cMkXEn1OGgfYgyEC+uCsxg=",
    "github": "SeanAshe/sshyard-plus"
  },
  "linux": {
    "depends": ["libsecret-1-0 (>= 0.19)"],
    "formats": ["deb"],
    "webview": false
  },
  "macos": {
    "icon": "icon/Assets.car",
    "infoPlist": {
      "CFBundleDocumentTypes": [
        {
          "CFBundleTypeName": "Folder",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "LSItemContentTypes": ["public.folder"]
        }
      ]
    }
  }
}
